# AI Diagram Studio 环境配置样例（复制为 deploy/.env 使用）
#
# ⚠️ 重要教训（首次容器部署失败的源头）：
#   不要在此文件写 RENDERER_CLI / STORAGE_ROOT / DATABASE_PATH / FRONTEND_DIST /
#   ICONS_DIR 等相对路径变量——compose 的 env_file 会覆盖镜像内置的**正确绝对路径**
#   （如 RENDERER_CLI=/studio/renderer/dist/src/cli.js），相对路径在容器内不存在，
#   会导致渲染器不可用、数据绕过数据卷。
#   LLM 在门户「LLM 配置」中管理。已有部署的 LLM_* 环境变量仅作首次迁移。

# --- 导入安全 ---
MAX_DRAWIO_UPLOAD_BYTES=10485760
MAX_XML_CELLS=5000

# --- 路径类变量（默认即可，仅在裸机部署需要自定义时取消注释）---
# 裸机内置默认：RENDERER_CLI=<仓库>/renderer/dist/src/cli.js（自动推导）
#              STORAGE_ROOT=<仓库>/storage、DATABASE_PATH=<仓库>/storage/studio.db
# 容器内置默认：RENDERER_CLI=/studio/renderer/dist/src/cli.js
#              STORAGE_ROOT=/data/storage、DATABASE_PATH=/data/storage/studio.db
# 覆盖时必须使用【绝对路径】；容器部署请保持注释状态。
# RENDERER_TIMEOUT_SECONDS=60
# RENDERER_OUTPUT_LIMIT_BYTES=8388608
# STORAGE_ROOT=/data/storage
# DATABASE_PATH=/data/storage/studio.db
# FRONTEND_DIST=/studio/frontend/dist
