# AI Diagram Studio 环境配置样例（复制为 deploy/.env 或进程环境使用）
# 密钥只经环境变量注入，不写入 Git；默认不记录原文拓扑与 IP。

# --- LLM（文本解析 / Patch 指令；关闭时 JSON 生成路径完整可用）---
LLM_ENABLED=false
# provider: mock | openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Renderer 子进程（FastAPI 调用）---
RENDERER_CLI=./renderer/dist/src/cli.js
RENDERER_TIMEOUT_SECONDS=60
RENDERER_OUTPUT_LIMIT_BYTES=8388608
ICONS_DIR=./renderer/assets/icons

# --- 存储 ---
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/studio.db

# --- 导入安全 ---
MAX_DRAWIO_UPLOAD_BYTES=10485760
MAX_XML_CELLS=5000

# --- 前端静态目录 ---
FRONTEND_DIST=./frontend/dist
