# AI Diagram Studio 环境配置样例（复制为 .env 使用）
# Phase 0：renderer 完全离线运行，不需要任何 LLM 配置；以下变量为 Phase 1 预留。

# --- LLM（Phase 1）---
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Renderer（Phase 1 由 FastAPI 子进程调用）---
# RENDERER_COMMAND=node renderer/dist/src/cli.js
# RENDERER_TIMEOUT_SECONDS=60

# --- 存储（Phase 1）---
# DATABASE_URL=sqlite:///./data/studio.db
# STORAGE_ROOT=./storage
