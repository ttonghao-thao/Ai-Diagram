[
  {"id": "L01", "text": "公网连防火墙，防火墙连核心交换机。", "diagramType": "network_topology", "nodes": [["公网", "cloud"], ["防火墙", "firewall"], ["核心交换机", "switch"]], "edges": [["公网", "防火墙", "physical"], ["防火墙", "核心交换机", "physical"]]},
  {"id": "L02", "text": "核心交换机分别连接服务器1、服务器2、服务器3，三台服务器同排从左到右按编号排序。", "diagramType": "network_topology", "nodes": [["核心交换机", "switch"], ["服务器1", "server"], ["服务器2", "server"], ["服务器3", "server"]], "edges": [["核心交换机", "服务器1", "physical"], ["核心交换机", "服务器2", "physical"], ["核心交换机", "服务器3", "physical"]]},
  {"id": "L03", "text": "互联网接出口路由器，出口路由器接边界防火墙，边界防火墙接核心交换机。", "diagramType": "network_topology", "nodes": [["互联网", "cloud"], ["出口路由器", "router"], ["边界防火墙", "firewall"], ["核心交换机", "switch"]], "edges": [["互联网", "出口路由器", "physical"], ["出口路由器", "边界防火墙", "physical"], ["边界防火墙", "核心交换机", "physical"]]},
  {"id": "L04", "text": "核心交换机连接汇聚交换机，汇聚交换机再连接接入交换机。", "diagramType": "network_topology", "nodes": [["核心交换机", "switch"], ["汇聚交换机", "switch"], ["接入交换机", "switch"]], "edges": [["核心交换机", "汇聚交换机", "physical"], ["汇聚交换机", "接入交换机", "physical"]]},
  {"id": "L05", "text": "边界防火墙与核心交换机相连，核心交换机连接服务器区防火墙，服务器区防火墙连接数据库。", "diagramType": "network_topology", "nodes": [["边界防火墙", "firewall"], ["核心交换机", "switch"], ["服务器区防火墙", "firewall"], ["数据库", "database"]], "edges": [["边界防火墙", "核心交换机", "physical"], ["核心交换机", "服务器区防火墙", "physical"], ["服务器区防火墙", "数据库", "physical"]]},
  {"id": "L06", "text": "光线路终端连分光器，分光器连光猫。采用通信接入网络主题。", "diagramType": "network_topology", "nodes": [["光线路终端", "generic"], ["分光器", "generic"], ["光猫", "generic"]], "edges": [["光线路终端", "分光器", "physical"], ["分光器", "光猫", "physical"]]},
  {"id": "L07", "text": "FTTR主网关连接FTTR从网关1和FTTR从网关2，采用中心辐射布局。", "diagramType": "network_topology", "nodes": [["FTTR主网关", "generic"], ["FTTR从网关1", "generic"], ["FTTR从网关2", "generic"]], "edges": [["FTTR主网关", "FTTR从网关1", "physical"], ["FTTR主网关", "FTTR从网关2", "physical"]]},
  {"id": "L08", "text": "无线控制器分别连接无线接入点1、无线接入点2。", "diagramType": "network_topology", "nodes": [["无线控制器", "generic"], ["无线接入点1", "generic"], ["无线接入点2", "generic"]], "edges": [["无线控制器", "无线接入点1", "physical"], ["无线控制器", "无线接入点2", "physical"]]},
  {"id": "L09", "text": "防火墙连接VPN网关，接入交换机连接摄像头。其余关系未指定。", "diagramType": "network_topology", "nodes": [["防火墙", "firewall"], ["VPN网关", "generic"], ["接入交换机", "switch"], ["摄像头", "client"]], "edges": [["防火墙", "VPN网关", "physical"], ["接入交换机", "摄像头", "physical"]]},
  {"id": "L10", "text": "厂商未知，路由器和交换机之间物理直连，不显示箭头和标签。", "diagramType": "network_topology", "nodes": [["路由器", "router"], ["交换机", "switch"]], "edges": [["路由器", "交换机", "physical"]]},
  {"id": "L11", "text": "交换机连接配线架，配线架连接智能配线架。图纸从左到右。", "diagramType": "network_topology", "nodes": [["交换机", "switch"], ["配线架", "generic"], ["智能配线架", "generic"]], "edges": [["交换机", "配线架", "physical"], ["配线架", "智能配线架", "physical"]]},
  {"id": "L12", "text": "调制解调器接路由器，路由器连接电脑。采用Networks通用设备主题。", "diagramType": "network_topology", "nodes": [["调制解调器", "generic"], ["路由器", "router"], ["电脑", "client"]], "edges": [["调制解调器", "路由器", "physical"], ["路由器", "电脑", "physical"]]},
  {"id": "L13", "text": "核心交换机连接GPU服务器，GPU服务器连接存储。连线采用黑色细直线。", "diagramType": "network_topology", "nodes": [["核心交换机", "switch"], ["GPU服务器", "server"], ["存储", "database"]], "edges": [["核心交换机", "GPU服务器", "physical"], ["GPU服务器", "存储", "physical"]]},
  {"id": "L14", "text": "防火墙、路由器、服务器三台设备。未提供任何连接关系。", "diagramType": "network_topology", "nodes": [["防火墙", "firewall"], ["路由器", "router"], ["服务器", "server"]], "edges": []},
  {"id": "L15", "text": "接入区包含无线接入点和接入交换机。接入交换机连接无线接入点。", "diagramType": "network_topology", "nodes": [["无线接入点", "generic"], ["接入交换机", "switch"]], "edges": [["接入交换机", "无线接入点", "physical"]]},
  {"id": "L16", "text": "核心交换机连接服务器1和服务器2，两台服务器放在最下方。隐藏物理链路标签。", "diagramType": "network_topology", "nodes": [["核心交换机", "switch"], ["服务器1", "server"], ["服务器2", "server"]], "edges": [["核心交换机", "服务器1", "physical"], ["核心交换机", "服务器2", "physical"]]},
  {"id": "L17", "text": "公网位于防火墙上面，防火墙位于核心交换机上面。仅连接公网与防火墙。", "diagramType": "network_topology", "nodes": [["公网", "cloud"], ["防火墙", "firewall"], ["核心交换机", "switch"]], "edges": [["公网", "防火墙", "physical"]]},
  {"id": "L18", "text": "核心交换机与出口路由器物理连接，链路名称叫千兆光纤。", "diagramType": "network_topology", "nodes": [["核心交换机", "switch"], ["出口路由器", "router"]], "edges": [["核心交换机", "出口路由器", "physical"]]},
  {"id": "L19", "text": "Internet connects to Firewall; Firewall connects to Core Switch. Use a Cisco theme.", "diagramType": "network_topology", "nodes": [["Internet", "cloud"], ["Firewall", "firewall"], ["Core Switch", "switch"]], "edges": [["Internet", "Firewall", "physical"], ["Firewall", "Core Switch", "physical"]]},
  {"id": "L20", "text": "An Edge Router is directly connected to Access Switch, which connects to Server 1.", "diagramType": "network_topology", "nodes": [["Edge Router", "router"], ["Access Switch", "switch"], ["Server 1", "server"]], "edges": [["Edge Router", "Access Switch", "physical"], ["Access Switch", "Server 1", "physical"]]},
  {"id": "L21", "text": "A wireless access point is connected to a switch. The link is physical.", "diagramType": "network_topology", "nodes": [["wireless access point", "generic"], ["switch", "switch"]], "edges": [["wireless access point", "switch", "physical"]]},
  {"id": "L22", "text": "Client calls API Gateway, and API Gateway calls Content Service.", "diagramType": "business_architecture", "nodes": [["Client", "client"], ["API Gateway", "service"], ["Content Service", "service"]], "edges": [["Client", "API Gateway", "logical"], ["API Gateway", "Content Service", "logical"]]},
  {"id": "L23", "text": "订单服务调用库存服务，库存服务向库存数据库写入数据。", "diagramType": "business_architecture", "nodes": [["订单服务", "service"], ["库存服务", "service"], ["库存数据库", "database"]], "edges": [["订单服务", "库存服务", "logical"], ["库存服务", "库存数据库", "dataflow"]]},
  {"id": "L24", "text": "门户服务访问认证服务，门户服务访问用户服务。两个下游服务在同一排。", "diagramType": "business_architecture", "nodes": [["门户服务", "service"], ["认证服务", "service"], ["用户服务", "service"]], "edges": [["门户服务", "认证服务", "logical"], ["门户服务", "用户服务", "logical"]]},
  {"id": "L25", "text": "访问网关调用大模型服务，大模型服务将结果写入数据库。", "diagramType": "business_architecture", "nodes": [["访问网关", "service"], ["大模型服务", "service"], ["数据库", "database"]], "edges": [["访问网关", "大模型服务", "logical"], ["大模型服务", "数据库", "dataflow"]]},
  {"id": "L26", "text": "业务区包含订单服务和支付服务。订单服务调用支付服务。", "diagramType": "business_architecture", "nodes": [["订单服务", "service"], ["支付服务", "service"]], "edges": [["订单服务", "支付服务", "logical"]]},
  {"id": "L27", "text": "消息队列向报表服务传输数据，不显示箭头。", "diagramType": "business_architecture", "nodes": [["消息队列", "service"], ["报表服务", "service"]], "edges": [["消息队列", "报表服务", "dataflow"]]},
  {"id": "L28", "text": "通知服务与审计服务为两个独立模块，目前没有调用或数据关系。", "diagramType": "business_architecture", "nodes": [["通知服务", "service"], ["审计服务", "service"]], "edges": []},
  {"id": "L29", "text": "外部系统调用接口网关；接口网关访问认证服务；终端设备调用接口网关。", "diagramType": "business_architecture", "nodes": [["外部系统", "service"], ["接口网关", "service"], ["认证服务", "service"], ["终端设备", "client"]], "edges": [["外部系统", "接口网关", "logical"], ["接口网关", "认证服务", "logical"], ["终端设备", "接口网关", "logical"]]},
  {"id": "L30", "text": "A Portal calls Identity Service. Identity Service reads data from the database named Accounts DB. Draw left to right.", "diagramType": "business_architecture", "nodes": [["Portal", "service"], ["Identity Service", "service"], ["Accounts DB", "database"]], "edges": [["Portal", "Identity Service", "logical"], ["Identity Service", "Accounts DB", "dataflow"]]}
]
