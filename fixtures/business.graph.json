{
  "schemaVersion": "1.0",
  "diagramId": "sample_business",
  "name": "示例：业务平台分区架构",
  "diagramType": "business_architecture",
  "groups": [
    {"id": "external", "label": "外部系统"},
    {"id": "platform", "label": "业务平台"},
    {"id": "terminal_zone", "label": "终端侧"}
