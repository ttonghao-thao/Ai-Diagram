{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-diagram-studio/patch.schema.json",
  "title": "GraphPatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseVersion", "operations"],
  "properties": {
    "baseVersion": {"type": "integer", "minimum": 1},
    "operations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/operation"}},
    "reason": {"type": "string", "maxLength": 2000},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "id"],
      "properties": {
        "op": {"enum": ["add_node", "update_node", "remove_node", "add_edge", "update_edge", "remove_edge", "add_group", "update_group", "remove_group"]},
        "id": {"$ref": "#/$defs/id"},
        "value": {"type": "object", "additionalProperties": true},
        "changes": {"type": "object", "additionalProperties": true},
        "cascade": {"type": "boolean", "default": false},
        "requiresConfirmation": {"type": "boolean", "default": false}
      }
    }
  }
}
