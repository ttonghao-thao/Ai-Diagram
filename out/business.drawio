        <mxCell id="n_client" value="终端设备" style="shape=mxgraph.networks.terminal;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aiKind=client;aiDeviceType=client;fontSize=12;fontColor=#24374D;whiteSpace=wrap;labelWidth=100;verticalLabelPosition=bottom;verticalAlign=top;align=center;aiKind=client;aiNetworkRole=endpoint;aiShapeId=networks.terminal;" vertex="1" parent="g_terminal_zone">
